{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/employer/[slug]",
      "regex": "^/employer/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/employer/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/hiring/[category]",
      "regex": "^/hiring/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcategory": "nxtPcategory"
      },
      "namedRegex": "^/hiring/(?<nxtPcategory>[^/]+?)(?:/)?$"
    },
    {
      "page": "/jobs/edit/[jobId]",
      "regex": "^/jobs/edit/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPjobId": "nxtPjobId"
      },
      "namedRegex": "^/jobs/edit/(?<nxtPjobId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/jobs/[category]",
      "regex": "^/jobs/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcategory": "nxtPcategory"
      },
      "namedRegex": "^/jobs/(?<nxtPcategory>[^/]+?)(?:/)?$"
    },
    {
      "page": "/jobs/[category]/[jobId]",
      "regex": "^/jobs/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcategory": "nxtPcategory",
        "nxtPjobId": "nxtPjobId"
      },
      "namedRegex": "^/jobs/(?<nxtPcategory>[^/]+?)/(?<nxtPjobId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/jobs/[category]/[jobId]/applicants",
      "regex": "^/jobs/([^/]+?)/([^/]+?)/applicants(?:/)?$",
      "routeKeys": {
        "nxtPcategory": "nxtPcategory",
        "nxtPjobId": "nxtPjobId"
      },
      "namedRegex": "^/jobs/(?<nxtPcategory>[^/]+?)/(?<nxtPjobId>[^/]+?)/applicants(?:/)?$"
    },
    {
      "page": "/worker/[slug]",
      "regex": "^/worker/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/worker/(?<nxtPslug>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
